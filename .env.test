# Test environment. Committed on purpose: these are local, non-secret values.
# Tests refuse to reset any database whose name does not end in `_test`.
DATABASE_URL="postgresql://zine:zine@127.0.0.1:5432/digital_zine_test?schema=public"
AUTH_SECRET="test-digital-zine-secret-not-for-production-32chars"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3417"
NEXT_PUBLIC_IMAGE_CDN_URL=""
LOCAL_STORAGE_DIR=".data/test-uploads"
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""
AWS_S3_PUBLIC_URL=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
# "true" turns on Stripe Tax at Checkout (finish Tax setup in the Stripe Dashboard first).
STRIPE_AUTOMATIC_TAX=""
