generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  free
  pro
}

/// Admins get every Pro feature without a subscription (DIG-17).
enum Role {
  user
  admin
}

/// DIG-26: a new upload is `processing` until the worker has stored its AVIF copies.
/// Photos from before DIG-26 are `ready` and keep their original file.
enum AssetStatus {
  processing
  ready
  failed
}

/// DIG-112: who can read a published zine. `private` needs the creator's access code.
enum ZineVisibility {
  public
  private
}

enum AssetKind {
  photo
  recipe
}

model User {
  id                   String                   @id @default(cuid())
  /// Short, lowercase, public: the creator part of a zine's address, /z/<publicId>/<slug> (DIG-102).
  /// The database makes it, so every way of creating a user gets one.
  publicId             String                   @unique @default(dbgenerated("substr(md5(((random())::text || (clock_timestamp())::text)), 1, 8)"))
  email                String                   @unique
  name                 String?
  /// Null for accounts that only sign in with Google (DIG-94).
  passwordHash         String?
  /// Google's stable `sub` for the account, once linked (DIG-94).
  googleId             String?                  @unique
  /// Null until the creator proves they own the email. Password sign-in needs it (DIG-94).
  emailVerifiedAt      DateTime?
  termsAcceptedAt      DateTime?
  stripeCustomerId     String?                  @unique
  stripeSubscriptionId String?                  @unique
  subscriptionStatus   String                   @default("inactive")
  tier                 Tier                     @default(free)
  role                 Role                     @default(user)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  assets               MediaAsset[]
  zines                Zine[]
  boards               Board[]
  recipes              Recipe[]
  verificationTokens   EmailVerificationToken[]
  passwordResetTokens  PasswordResetToken[]
  /// Sessions issued before this moment are signed out (DIG-107). Set when a password is reset, so
  /// a stolen session does not survive. Null until then.
  sessionsValidAfter   DateTime?
  /// Set by an admin (DIG-137): the account cannot sign in and its zines are hidden. Null when active.
  deactivatedAt        DateTime?
  /// The creator's current handle, lowercase: their profile is /u/<handle> (DIG-111). Null until
  /// they pick one. Every handle they have used is also in `UserHandle`, which keeps it theirs.
  handle               String?                  @unique
  /// A short plain-text bio for the profile page (DIG-111).
  bio                  String?
  handles              UserHandle[]
}

/// Every handle a creator has used, current and old (DIG-111). The handle is the key, so claiming
/// one is a single insert that no other account can race. An old handle redirects to the current
/// one and nobody else can take it. Deleting the account frees them.
model UserHandle {
  handle    String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AdminActionType {
  grant_admin
  revoke_admin
  deactivate
  reactivate
  delete_user
}

/// DIG-136: what an admin did to an account, and when. IDs only, with no foreign keys, so a record
/// outlives both accounts and holds no names or emails.
model AdminAction {
  id        String          @id @default(cuid())
  actorId   String
  targetId  String
  action    AdminActionType
  createdAt DateTime        @default(now())

  @@index([targetId, createdAt])
  @@index([actorId, createdAt])
}

/// DIG-94: a single-use email verification link. Only the SHA-256 of the token is stored.
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// DIG-107: a single-use password reset link, valid for one hour. Only the SHA-256 of the token is
/// stored. A creator has at most one at a time: asking again retires the older link.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// DIG-24: a creator's saved Fujifilm recipe. Linked photos keep their own copy in
/// `MediaAsset.recipe`, rewritten when this is edited; deleting it leaves the copies.
model Recipe {
  id        String       @id @default(cuid())
  ownerId   String
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// The recipe's settings without its name; see `src/lib/fuji-recipe.ts`.
  settings  Json         @db.JsonB
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  assets    MediaAsset[]

  @@unique([ownerId, name])
}

/// DIG-25: a creator keeps several Vision Boards. Every photo is on one board and every zine is
/// built from one board. Storage is one quota for the whole account, not per board.
model Board {
  id         String           @id @default(cuid())
  ownerId    String
  owner      User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  assets     MediaAsset[]
  zines      Zine[]
  placements BoardPlacement[]
  notes      BoardNote[]
  /// The last view used on wide and narrow screens, and the grid layout (DIG-85): `boardViewPrefsSchema`.
  viewPrefs  Json?            @db.JsonB

  @@index([ownerId, sortOrder])
}

/// DIG-85: where a photo sits on its board's free-form canvas. Never changes board order. A photo is
/// on one board, so it has at most one placement.
model BoardPlacement {
  assetId  String     @id
  asset    MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  boardId  String
  board    Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  x        Float
  y        Float
  width    Float
  /// Degrees, -15 to 15.
  rotation Float      @default(0)
  z        Int        @default(0)
  /// "print" (white border) or "plain".
  look     String     @default("print")
  tape     Boolean    @default(false)

  @@index([boardId])
}

/// DIG-85: a sticky note on a board's free-form canvas. Never part of a zine or PDF.
model BoardNote {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  text      String
  x         Float
  y         Float
  width     Float
  rotation  Float    @default(0)
  z         Int      @default(0)
  createdAt DateTime @default(now())

  @@index([boardId])
}

model MediaAsset {
  id              String          @id @default(cuid())
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// The app moves photos to another board before deleting one. NoAction (checked at the end of
  /// the statement) still lets deleting a user cascade through boards and photos together.
  boardId         String
  board           Board           @relation(fields: [boardId], references: [id], onDelete: NoAction)
  storageKey      String          @unique
  publicUrl       String
  originalName    String?
  /// A name the creator gives the photo in the app (DIG-34). Null means "use the file name".
  name            String?
  mimeType        String          @default("image/jpeg")
  /// Bytes in storage, read from the storage driver at create time, never from the client (DIG-32).
  /// Rows from before DIG-32 are 0.
  sizeBytes       Int             @default(0)
  status          AssetStatus     @default(ready)
  /// Why processing failed, shown to the owner with a Retry button.
  processingError String?
  /// Pixel size after the camera's rotation is applied. Null until processed.
  width           Int?
  height          Int?
  /// A tiny inline WebP shown while the photo loads.
  blurDataUrl     String?
  /// Crop, frame, and board card size (DIG-33): see `src/lib/photo-edit.ts`. Null is unedited.
  /// The stored image is never changed.
  edit            Json?           @db.JsonB
  kind            AssetKind       @default(photo)
  exif            Json?           @db.JsonB
  recipe          Json?           @db.JsonB
  /// The saved recipe this photo uses (DIG-24). `recipe` holds a copy of its settings.
  recipeId        String?
  savedRecipe     Recipe?         @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  placement       BoardPlacement?

  @@index([ownerId, sortOrder])
  @@index([boardId, sortOrder])
}

model Zine {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// A board cannot be deleted while a zine links to it (DIG-25).
  boardId     String
  board       Board      @relation(fields: [boardId], references: [id], onDelete: NoAction)
  title       String
  description String?
  slug        String
  published   Boolean    @default(false)
  publishedAt DateTime?
  /// How this zine's PDF looks (DIG-64), validated by `pdfSettingsSchema`. Null until the creator picks a style.
  pdfSettings Json?      @db.JsonB
  /// DIG-112: a private zine is published but readable only with the access code.
  visibility        ZineVisibility @default(public)
  /// bcrypt hash of the access code; the code itself is never stored. Null until one is set.
  accessCodeHash    String?
  /// Bumped when the code changes or the zine turns private, which ends every earlier unlock.
  accessCodeVersion Int            @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  pages       ZinePage[]

  /// A slug is unique per creator, not across the site (DIG-102).
  @@unique([ownerId, slug])
  @@index([ownerId])
  @@index([boardId])
}

model ZinePage {
  id          String   @id @default(cuid())
  zineId      String
  zine        Zine     @relation(fields: [zineId], references: [id], onDelete: Cascade)
  pageNumber  Int
  templateId  String   @default("full-bleed-photo")
  content     Json     @db.JsonB
  flipEnabled Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([zineId, pageNumber])
  @@index([zineId, pageNumber])
}

/// DIG-28: fixed-window request counters, keyed like "write:<userId>" or "signin-ip:<ip>".
/// Kept in Postgres so every app instance shares them.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
