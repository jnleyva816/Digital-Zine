    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma migrate deploy && tsx prisma/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db:reset": "tsx scripts/test-db-reset.ts",
    "smoke": "tsx scripts/smoke.ts",
    "brand:generate": "tsx scripts/generate-brand-assets.ts",
    "admin:create": "tsx scripts/admin-create.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "@sentry/nextjs": "11.16.0",
    "bcryptjs": "^3.0.3",
    "exifreader": "4.54.0",
    "lucide-react": "^1.77.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pg-boss": "^12.39.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "stripe": "23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.20.1",
    "eslint-config-next": "15.5.29",
    "jsdom": "^31.0.1",
    "playwright-core": "^1.50.1",
    "postcss": "^8.5.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.33"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.5"
    }
