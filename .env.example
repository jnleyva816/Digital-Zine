# PostgreSQL connection string
DATABASE_URL="postgresql://zine:zine@127.0.0.1:5432/digital_zine?schema=public"

# Auth.js secret. Required: generate one with `openssl rand -base64 32`. A production server
# refuses to start without one, or with a value committed in this repository.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Canonical public base URL (used for Open Graph share links & Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional CDN image loader prefix (leave blank to serve directly from app/S3)
# Example: https://cdn.example.com/cdn-cgi/image
NEXT_PUBLIC_IMAGE_CDN_URL=""

# Local storage directory (gitignored; used when S3 env vars are omitted)
LOCAL_STORAGE_DIR=".data/uploads"

# Optional S3-compatible object storage (activates direct presigned PUT when set)
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""
AWS_S3_PUBLIC_URL=""

# Optional Stripe subscriptions ($15/month Pro tier; app degrades gracefully without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
# "true" turns on Stripe Tax at Checkout (finish Tax setup in the Stripe Dashboard first).
STRIPE_AUTOMATIC_TAX=""
