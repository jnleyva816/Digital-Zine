# PostgreSQL connection string
DATABASE_URL="postgresql://zine:zine@127.0.0.1:5432/digital_zine?schema=public"

# Auth.js secret. Required: generate one with `openssl rand -base64 32`. A production server
# refuses to start without one, or with a value committed in this repository.
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# The public URL of the site. Leave unset locally. Set it behind a proxy (Railway, Cloudflare):
# otherwise Auth.js builds links from the container's own address (https://localhost:8080) and Google
# sign-in fails with redirect_uri_mismatch. It must match the host in the Google redirect URI.
# AUTH_URL="https://your-domain.example"

# Sign up with Google (optional). Create an OAuth client in the Google Cloud Console with the redirect
# URI <NEXT_PUBLIC_APP_URL>/api/auth/callback/google. Unset hides "Continue with Google".
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Verification emails, sent through Resend. Required in production for sign-up. Without a key outside
# production, the verification link is printed to the server console instead.
RESEND_API_KEY=""
# A sender on a domain verified in Resend, e.g. "Folio <hello@yourdomain.com>".
EMAIL_FROM=""

# Canonical public base URL (used for Open Graph share links & Stripe redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional CDN image loader prefix (leave blank to serve directly from app/S3)
# Example: https://cdn.example.com/cdn-cgi/image
NEXT_PUBLIC_IMAGE_CDN_URL=""

# Local storage directory (gitignored; used when S3 env vars are omitted)
LOCAL_STORAGE_DIR=".data/uploads"

# Optional S3-compatible object storage (activates direct presigned PUT when set)
AWS_S3_BUCKET=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_ENDPOINT=""
AWS_S3_PUBLIC_URL=""

# Optional Stripe subscriptions ($15/month Pro tier; app degrades gracefully without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRO_PRICE_ID=""
# "true" turns on Stripe Tax at Checkout (finish Tax setup in the Stripe Dashboard first).
STRIPE_AUTOMATIC_TAX=""

# How many proxies sit in front of the app (load balancer, CDN). The client IP for sign-in rate
# limits is taken that many entries from the right of X-Forwarded-For, which clients cannot forge.
# 1 fits most hosts; set it for your host when deploying.
TRUSTED_PROXY_HOPS="1"

# Error reporting (Sentry). Unset means nothing is sent. NEXT_PUBLIC_SENTRY_DSN is read at build time.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Build time only: upload source maps for readable stack traces.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
